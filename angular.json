{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "portfolio": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss",
          "standalone": false
        },
        "@schematics/angular:directive": {
          "standalone": false
        },
        "@schematics/angular:pipe": {
          "standalone": false
        }
      },
      "root": "portfolio",
      "sourceRoot": "portfolio/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "ngx-build-plus:browser",
          "options": {
            "outputPath": "portfolio/dist/portfolio",
            "index": "portfolio/src/index.html",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "portfolio/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              "portfolio/src/favicon.ico",
              "portfolio/src/assets"
            ],
            "styles": [
              "@angular/material/prebuilt-themes/pink-bluegrey.css",
              "portfolio/src/styles.scss"
            ],
            "scripts": [],
            "main": "portfolio/src/main.ts",
            "extraWebpackConfig": "portfolio/webpack.config.js",
            "commonChunk": false
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kb",
                  "maximumError": "5mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "150kb",
                  "maximumError": "200kb"
                }
              ],
              "outputHashing": "all",
              "extraWebpackConfig": "portfolio/webpack.prod.config.js"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "ngx-build-plus:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "portfolio:build:production",
              "extraWebpackConfig": "portfolio/webpack.prod.config.js"
            },
            "development": {
              "buildTarget": "portfolio:build:development"
            }
          },
          "defaultConfiguration": "development",
          "options": {
            "port": 4200,
            "publicHost": "http://localhost:4200",
            "extraWebpackConfig": "portfolio/webpack.config.js"
          }
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "portfolio/tsconfig.spec.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "portfolio/public"
              }
            ],
            "styles": [
              "portfolio/src/styles.scss"
            ],
            "scripts": []
          }
        }
      }
    },
    "blog-mfe": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "blog-mfe",
      "sourceRoot": "blog-mfe/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "ngx-build-plus:browser",
          "options": {
            "outputPath": "blog-mfe/dist/blog-mfe",
            "index": "blog-mfe/src/index.html",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "blog-mfe/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "blog-mfe/public",
                "output": "."
              }
            ],
            "styles": [
              "blog-mfe/src/styles.scss"
            ],
            "scripts": [],
            "main": "blog-mfe/src/main.ts",
            "extraWebpackConfig": "blog-mfe/webpack.config.js",
            "commonChunk": false
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kb",
                  "maximumError": "5mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "150kb",
                  "maximumError": "200kb"
                }
              ],
              "outputHashing": "all",
              "extraWebpackConfig": "blog-mfe/webpack.prod.config.js"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "ngx-build-plus:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "blog-mfe:build:production",
              "extraWebpackConfig": "blog-mfe/webpack.prod.config.js"
            },
            "development": {
              "buildTarget": "blog-mfe:build:development"
            }
          },
          "defaultConfiguration": "development",
          "options": {
            "port": 4201,
            "publicHost": "http://localhost:4201",
            "extraWebpackConfig": "blog-mfe/webpack.config.js"
          }
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "blog-mfe/tsconfig.spec.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "blog-mfe/public"
              }
            ],
            "styles": [
              "blog-mfe/src/styles.scss"
            ],
            "scripts": []
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
